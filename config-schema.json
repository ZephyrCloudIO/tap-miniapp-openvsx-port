{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ZephyrCloudIO/tap-miniapp-openvsx-port/config-schema.json",
  "title": "TAP OpenVSX port recipe",
  "type": "object",
  "required": ["schemaVersion", "source", "conversion", "tap", "npm", "output"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "converter": {
      "type": "object",
      "properties": {
        "repository": { "type": "string", "format": "uri" },
        "package": { "const": "@theaiplatform/openvsx-port" },
        "version": { "type": "string", "minLength": 1 },
        "binary": { "const": "tap-openvsx" },
        "registry": { "const": "https://registry.npmjs.org" },
        "access": { "const": "public" },
        "packagePage": { "type": "string", "format": "uri" }
      },
      "additionalProperties": false
    },
    "source": {
      "type": "object",
      "required": [
        "provider",
        "registryUrl",
        "extensionId",
        "version",
        "sha256"
      ],
      "properties": {
        "provider": { "const": "openvsx" },
        "registryUrl": { "type": "string", "format": "uri" },
        "extensionId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9-]*\\.[A-Za-z0-9][A-Za-z0-9-]*$"
        },
        "version": { "type": "string", "minLength": 1, "maxLength": 128 },
        "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      },
      "additionalProperties": false
    },
    "conversion": {
      "type": "object",
      "required": ["profile", "targets"],
      "properties": {
        "profile": { "const": "static-webview" },
        "targets": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "enum": ["desktop", "mobile"] }
        },
        "adapter": {
          "type": "object",
          "required": ["package", "version", "binary"],
          "properties": {
            "package": { "type": "string", "minLength": 1 },
            "version": {
              "type": "string",
              "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:[-+][0-9A-Za-z.-]+)?$"
            },
            "binary": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
            },
            "args": {
              "type": "array",
              "maxItems": 64,
              "items": { "type": "string", "maxLength": 4096 }
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": true
    },
    "tap": { "type": "object" },
    "npm": {
      "type": "object",
      "required": ["name", "version", "access", "registry"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "access": { "const": "public" },
        "registry": { "const": "https://registry.npmjs.org" }
      },
      "additionalProperties": true
    },
    "output": {
      "type": "object",
      "required": [
        "workingDirectory",
        "npmTarball",
        "compatibilityReport",
        "attestation"
      ],
      "properties": {
        "workingDirectory": { "type": "string", "minLength": 1 },
        "npmTarball": { "type": "string", "minLength": 1 },
        "compatibilityReport": { "type": "string", "minLength": 1 },
        "attestation": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
